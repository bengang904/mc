  "legal_last_updated": "अंतिम अपडेट: {{date}}",
  "legal_tos_title": "सेवा की शर्तें",
  "legal_tos_1": "ईगलक्राफ्ट ('सेवा') का उपयोग करके, आप इन सेवा की शर्तों से बंधे होने के लिए सहमत हैं। यदि आप शर्तों के किसी भी हिस्से से असहमत हैं, तो आप सेवा का उपयोग नहीं कर सकते।",
  "legal_tos_2_title": "1. अधिकार क्षेत्र",
  "legal_tos_2_content": "यह वेबसाइट ईरान के इस्लामी गणराज्य से संचालित और अनुरक्षित है। सभी कानूनी मामले ईरानी कानून द्वारा शासित होंगे, और कोई भी विवाद ईरानी अदालतों के अधिकार क्षेत्र के अधीन होगा।",
  "legal_tos_3_title": "2. उपयोग लाइसेंस",
  "legal_tos_3_content": "सेवा का अस्थायी रूप से केवल व्यक्तिगत, गैर-व्यावसायिक देखने के लिए उपयोग करने की अनुमति दी गई है। यह एक लाइसेंस है, स्वामित्व का हस्तांतरण नहीं।",
  "legal_tos_4_title": "3. प्रतिबंध",
  "legal_tos_4_content": "आप यह नहीं कर सकते:",
  "legal_tos_4_item_1": "सामग्री को संशोधित या कॉपी करना",
  "legal_tos_4_item_2": "किसी भी व्यावसायिक उद्देश्य के लिए सामग्री का उपयोग करना",
  "legal_tos_4_item_3": "किसी भी सॉफ्टवेयर को डीकंपाइल या रिवर्स इंजीनियर करने का प्रयास करना",
  "legal_tos_4_item_4": "किसी भी कॉपीराइट या मालिकाना नोटिस को हटाना",
  "legal_tos_5_title": "4. परिवर्तन",
  "legal_tos_5_content": "हम बिना किसी सूचना के किसी भी समय इन शर्तों को अपडेट कर सकते हैं। सेवा का निरंतर उपयोग नवीनतम संस्करण के लिए सहमति का गठन करता है।",
  "legal_privacy_title": "गोपनीयता नीति",
  "legal_privacy_1": "आपकी गोपनीयता हमारे लिए महत्वपूर्ण है। यह नीति बताती है कि हम कौन सी जानकारी एकत्र करते हैं और इसका उपयोग कैसे किया जाता है।",
  "legal_privacy_2_title": "सूचना संग्रह",
  "legal_privacy_2_content": "हम ब्राउज़र प्रकार, ऑपरेटिंग सिस्टम और एक्सेस समय जैसे तकनीकी और उपयोग-संबंधी डेटा एकत्र कर सकते हैं।",
  "legal_privacy_3_title": "कुकीज़",
  "legal_privacy_3_content": "आपके अनुभव को बढ़ाने के लिए कुकीज़ का उपयोग किया जा सकता है। आप कुकीज़ को प्रबंधित करने के लिए अपनी ब्राउज़र सेटिंग्स को समायोजित कर सकते हैं।",
  "legal_copyright_title": "कॉपीराइट नीति",
  "legal_copyright_1": "हम दूसरों के बौद्धिक संपदा अधिकारों का सम्मान करते हैं।",
  "legal_copyright_2_title": "उल्लंघन नोटिस",
  "legal_copyright_2_content_1": "यदि आपको लगता है कि आपके अधिकारों का उल्लंघन हुआ है, तो आप हमसे संपर्क कर सकते हैं:",
  "legal_copyright_2_content_2": "डिस्कॉर्ड संपर्क",
  "legal_copyright_2_content_3": "कृपया ध्यान दें कि Eaglercraft.ir ईरानी अधिकार क्षेत्र के तहत काम करता है, और सभी दावों का मूल्यांकन ईरानी कानून के अनुसार किया जाएगा।",
  "legal_disclaimer_title": "अस्वीकरण",
  "legal_disclaimer_1": "माइनक्राफ्ट और संबंधित संपत्तियां Mojang AB की संपत्ति हैं।",
  "legal_disclaimer_2": "यह वेबसाइट Mojang AB से संबंधित किसी भी कॉपीराइट सामग्री को होस्ट या वितरित नहीं करती है।",
  "legal_disclaimer_3": "यह वेबसाइट ईगलक्राफ्ट परियोजना से किसी भी फाइल को होस्ट नहीं करती है, न ही यह डीकंपाइल किए गए माइनक्राफ्ट 1.8 स्रोत कोड या संसाधनों की सेवा करती है।",
  "legal_disclaimer_4": "सभी संबंधित संपत्तियां तीसरे पक्ष की सेवाओं के माध्यम से वितरित की जाती हैं और Eaglercraft.ir पर होस्ट नहीं की जाती हैं।",
  "lang_en": "अंग्रेज़ी",
